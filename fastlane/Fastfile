# Bygger og laster opp til TestFlight.
#
# Signering: automatisk, med App Store Connect API-nøkkelen alene. Siden Xcode 13 kan
# `-allowProvisioningUpdates` opprette og hente provisioning-profiler OG bruke Apples
# *cloud-managed* distribusjonssertifikat — den private nøkkelen blir hos Apple. Derfor
# trengs verken match, sertifikat-repo eller passfrase, og vi bruker ikke opp de 2-3
# manuelle distribusjonssertifikatene kontoen har.
#
# Ingen hemmeligheter i denne fila: alt kommer fra GitHub-secrets via miljøet.
default_platform(:ios)

APP_ID = "no.gustavs1.hjemme"
# Widgeten er et eget mål og trenger sin EGEN profil. En profil dekker én bundle-ID, så
# appens profil kan ikke signere widgeten — arkiveringen feiler på widget-målet med en
# feil som peker på appen, ikke på widgeten.
WIDGET_ID = "#{APP_ID}.widget"

platform :ios do
  desc "Bygg og last opp til TestFlight"
  lane :beta do
    # Midlertidig keychain på CI. Uten den har ikke runneren noe sted å legge
    # signeringsmateriellet, og feilen som kommer er lite opplysende.
    setup_ci if ENV["CI"]

    # Workflowen har lagt .p8-fila her — xcodebuild leter i ~/.appstoreconnect/private_keys.
    key_id = ENV.fetch("ASC_KEY_ID")
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
      in_house: false
    )

    # Signering via match: henter det EKSISTERENDE distribusjonssertifikatet fra
    # sertifikat-repoet og lager (første gang) en appstore-profil for vår bundle-ID.
    #
    # Automatisk signering ble prøvd i tre varianter og ba hver gang om en
    # «iOS App Development»-profil, som lagde et nytt utviklingssertifikat per kjøring
    # til kontoens kvote var brukt opp. match gjenbruker ett sertifikat i stedet.
    # Hva Apple mener app-ID-ene kan.
    #
    # En profil arver kapabilitetene fra app-ID-en i det den lages. Mangler App Groups
    # der, blir profilen laget uten — og xcodebuild sier «requires a provisioning profile
    # with the App Groups feature», som høres ut som en profilfeil, men er en app-ID-feil.
    # Uten denne utskriften er det umulig å skille de to fra en byggelogg.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key_id,
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: key_path
    )
    [APP_ID, WIDGET_ID].each do |bid|
      b = Spaceship::ConnectAPI::BundleId.find(bid)
      if b.nil?
        UI.important("#{bid}: finnes ikke på kontoen ennå — match lager den")
        next
      end
      typer = b.get_capabilities.map(&:capability_type)
      UI.message("#{bid}: #{typer.empty? ? '(ingen kapabiliteter)' : typer.join(', ')}")
      unless typer.include?("APP_GROUPS")
        UI.important("#{bid} mangler App Groups. Slå den på i portalen og velg " \
                     "gruppa, ellers blir profilen laget uten og bygget feiler.")
      end
    end

    #
    # Begge bundle-ID-ene i ETT kall: match gjenbruker da samme sertifikat for begge.
    # To separate kall gjør samme jobb, men rører sertifikat-repoet to ganger.
    match(
      type: "appstore",
      app_identifier: [APP_ID, WIDGET_ID],
      api_key: api_key,
      readonly: false,          # første kjøring må få lage profilene
      # En profil får kapabilitetene app-ID-en hadde DA den ble laget. Slår man på App
      # Groups i portalen etterpå, fortsetter match å gjenbruke den gamle profilen —
      # den er gyldig, bare uten den nye kapabiliteten, og xcodebuild klager på profilen
      # framfor å si hva som mangler. Utløs kjøringen med «nye_profiler» for å få ferske.
      force: ENV["MATCH_NYE_PROFILER"] == "true",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    # (Byggnummeret settes av XcodeGen fra $BUILD_NUMBER — se project.yml.
    # increment_build_number virker ikke når Info.plist genereres av XcodeGen.)

    # Manuell signering: match har allerede lagt riktig sertifikat og profil på plass.
    # -allowProvisioningUpdates er BEVISST borte — det er den som ba Apple om nye
    # sertifikater. Profilnavnet kommer fra match.
    profiler = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    profil = profiler[APP_ID]
    profil_widget = profiler[WIDGET_ID]
    UI.user_error!("match ga ingen profil for #{WIDGET_ID}") if profil_widget.nil?

    # PROVISIONING_PROFILE_SPECIFIER på kommandolinja gjelder ALLE mål i bygget, og ville
    # tvunget appens profil på widgeten. Derfor bare sertifikatet her — hvilken profil
    # hvert mål får, avgjøres av export_options under.
    signering = "CODE_SIGN_STYLE=Manual " \
                "CODE_SIGN_IDENTITY='Apple Distribution'"

    build_app(
      scheme: "NestifyHub",
      # Release EKSPLISITT. Uten dette arkiverte Xcode med utviklings-signering og bad om
      # en «iOS App Development»-profil — og laget et NYTT utviklingssertifikat for hver
      # kjøring, til kontoens sertifikatkvote var brukt opp.
      configuration: "Release",
      export_method: "app-store",
      project: "NestifyHub.xcodeproj",
      xcargs: signering,
      # IKKE sett export_xcargs med de samme argumentene: gym legger selv
      # -authenticationKey* på eksport-steget når api_key er satt, og xcodebuild
      # avviser at flagget oppgis to ganger.
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profil, WIDGET_ID => profil_widget }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false   # interne testere trenger ingen Beta App Review
    )
  end
end
