<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Appen og widgeten deler denne mappa. Den ER kanalen mellom dem: widgeten er en
       egen prosess og kan ikke lese appens minne. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.no.gustavs1.hjemme</string>
  </array>
</dict>
</plist>
